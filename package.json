{
	"name": "@tknf/typefetcher",
	"version": "1.2.0",
	"description": "TypeScript-first API client with Standard Schema support, providing excellent DX and strict type safety.",
	"keywords": [
		"typescript",
		"api-client",
		"fetch",
		"http",
		"type-safe",
		"standard-schema",
		"validation",
		"dx"
	],
	"repository": {
		"url": "https://github.com/tknf/typefetcher"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"license": "MIT",
	"author": "tknf <dev@tknf.net>",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome lint",
		"format": "biome format",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run lint"
	},
	"peerDependencies": {
		"valibot": "^1.0.0",
		"zod": "^3.25.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		},
		"valibot": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@types/node": "^25.5.2",
		"@vitest/coverage-v8": "^4.1.2",
		"node-fetch": "^3.3.2",
		"tsdown": "^0.21.7",
		"typescript": "^6.0.2",
		"undici": "^8.0.2",
		"valibot": "^1.3.1",
		"vitest": "^4.1.2",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.0.0"
	}
}
